{
  "name": "equiprent-model-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env src/server.js",
    "kyc": "node --watch --env-file-if-exists=.env scripts/start-kyc-server.mjs",
    "start:kyc": "node --watch --env-file-if-exists=.env scripts/start-kyc-server.mjs",
    "test:kyc": "node --env-file-if-exists=.env scripts/test-surepass.mjs",
    "test:consent": "node scripts/test-all-kyc-consent.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "export": "node --env-file-if-exists=.env scripts/export.mjs",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "validate": "node scripts/validate.mjs",
    "inspect:db": "node scripts/inspect-db.mjs",
    "check:swagger": "node --env-file-if-exists=.env scripts/check-swagger.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "pino-pretty": "^13.2.0"
  }
}
